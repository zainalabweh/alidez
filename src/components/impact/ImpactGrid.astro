---
import Icon from '@/components/Icon.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);

const items = [
  { n: 1, icon: 'droplet' },
  { n: 2, icon: 'cloud' },
  { n: 3, icon: 'thermometer' },
  { n: 4, icon: 'mountain' },
  { n: 5, icon: 'trees' },
  { n: 6, icon: 'bird' },
  { n: 7, icon: 'wheat' },
];
---
<section>
  <div class="wrapper section-y grid grid-cols-[repeat(auto-fit,minmax(min(100%,250px),1fr))] gap-y-[clamp(40px,4.4vw,56px)] gap-x-[clamp(24px,3vw,40px)]">
    <div class="pr-[clamp(0px,1.2vw,16px)]">
      <Eyebrow label={t('impact.why.label')} />
      <h2 class="mt-[22px] font-serif font-medium text-[clamp(28px,2.6vw,36px)] leading-[1.16] tracking-[-0.015em] text-ink text-balance">
        {t('impact.why.heading')}
      </h2>
    </div>

    {items.map((item) => (
      <div class="flex flex-col pt-7 border-t border-line">
        <Icon name={item.icon} class="w-[26px] h-[26px] text-brand" />
        <h3 class="mt-[22px] heading-item text-ink">{t(`impact.item${item.n}.t`)}</h3>
        <p class="mt-2.5 text-base leading-[1.6] text-ink-soft text-pretty">{t(`impact.item${item.n}.d`)}</p>
      </div>
    ))}
  </div>
</section>
