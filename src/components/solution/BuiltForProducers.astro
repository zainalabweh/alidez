---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import producersImg from '@/assets/ai/livestock-producers.jpg';
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
const benefits = [1, 2, 3, 4, 5, 6];
---
<section class="py-20 md:py-28 px-5 md:px-12 bg-panel">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
    <div class="flex flex-col gap-6">
      <span class="text-brand text-xs font-bold uppercase tracking-widest">{t('sol.producers.label')}</span>
      <h2 class="font-serif text-3xl md:text-4xl font-semibold text-ink leading-tight">{t('sol.producers.heading')}</h2>

      <ul class="flex flex-col gap-4 mt-2">
        {benefits.map((n) => (
          <li class="flex items-start gap-3">
            <Icon name="check" class="w-5 h-5 text-leaf mt-0.5 shrink-0" />
            <span class="text-base text-ink-soft">{t(`sol.producers.${n}`)}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="rounded-2xl overflow-hidden shadow-xl">
      <Image
        src={producersImg}
        alt={t('sol.producers.heading')}
        class="w-full h-auto object-cover aspect-[4/3]"
        widths={[640, 960]}
        sizes="(min-width: 1024px) 50vw, 100vw"
      />
    </div>
  </div>
</section>
