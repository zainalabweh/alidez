---
import Eyebrow from '@/components/Eyebrow.astro';
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---
<section>
  <div class="wrapper section-y grid grid-cols-[repeat(auto-fit,minmax(min(100%,400px),1fr))] gap-[clamp(28px,6vw,96px)] items-start">
    <div>
      <Eyebrow label={t('sol.why.label')} />
      <h2 class="mt-[22px] heading-display text-ink">{t('sol.why.heading')}</h2>
    </div>
    <div class="flex flex-col gap-[clamp(20px,2.4vw,28px)] pt-[clamp(0px,1.2vw,10px)]">
      <p class="lead text-ink-soft">{t('sol.why.p1')}</p>
      <p class="font-serif font-medium text-[clamp(22px,2.2vw,30px)] leading-[1.3] tracking-[-0.01em] text-ink text-pretty">{t('sol.why.p2')}</p>
    </div>
  </div>
</section>
