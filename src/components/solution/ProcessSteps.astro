---
import { Image } from 'astro:assets';
import Eyebrow from '@/components/Eyebrow.astro';
import { useTranslations, type Lang } from '@/i18n/utils';

// All four photos exist in Zain's pitch deck (slide 5). Steps 2 and 3 are
// VIDEOS in the deck - either pull a frame or use short muted loops later.
import step1 from '@/assets/photos/Nopal_Plant_Workers.jpg';
import step2 from '@/assets/ai/process-ground.jpg';
import step3 from '@/assets/ai/process-pellets.jpg';
import step4 from '@/assets/ai/process-livestock.jpg';

interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);

const steps = [
  { n: 1, img: step1 },
  { n: 2, img: step2 },
  { n: 3, img: step3 },
  { n: 4, img: step4 },
];
---
<section>
  <div class="wrapper section-y">
    <Eyebrow label={t('sol.process.label')} />
    <h2 class="mt-[22px] heading-section text-ink">{t('sol.process.heading')}</h2>

    <ol class="mt-[clamp(36px,4.4vw,56px)] grid grid-cols-[repeat(auto-fit,minmax(min(100%,230px),1fr))] gap-y-[clamp(32px,3vw,40px)] gap-x-[clamp(16px,2.4vw,32px)]">
      {steps.map((s) => (
        <li class="flex flex-col">
          <div class="relative aspect-[4/3] rounded-[14px] overflow-hidden bg-panel">
            <Image
              src={s.img}
              alt={t(`sol.process.${s.n}.t`)}
              class="w-full h-full object-cover transition-transform duration-[800ms] ease-[cubic-bezier(.2,.7,.2,1)] hover:scale-[1.04] motion-reduce:transition-none motion-reduce:hover:scale-100"
              widths={[400, 600]}
              sizes="(min-width: 1100px) 280px, (min-width: 560px) 50vw, 100vw"
            />
            <span class="absolute top-3 left-3 min-w-[30px] h-[30px] px-2.5 rounded-full bg-amber text-soil text-[13px] font-bold flex items-center justify-center pointer-events-none" aria-hidden="true">{s.n}</span>
          </div>
          <h3 class="mt-[18px] heading-item text-ink">{t(`sol.process.${s.n}.t`)}</h3>
          <p class="mt-1.5 text-[15.5px] leading-[1.5] text-ink-soft">{t(`sol.process.${s.n}.d`)}</p>
        </li>
      ))}
    </ol>

    <p class="mt-[clamp(48px,6vw,80px)] max-w-[820px] pl-[clamp(20px,2.4vw,28px)] border-l-3 border-leaf text-[clamp(18px,1.6vw,21px)] leading-[1.6] text-ink text-pretty">
      {t('sol.process.body')}
    </p>
  </div>
</section>
