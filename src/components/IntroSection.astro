---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import cactusImg from '@/assets/photos/Nopal_Row_3.jpg';
import { useTranslations, type Lang } from '@/i18n/utils';
import { mailto } from '@/config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

// This section becomes a carousel later: turn `images` into an array prop
// and map over it - the layout stays the same.
const chips = [
  { icon: 'sun', key: 'intro.chip1' },
  { icon: 'calendar', key: 'intro.chip2' },
  { icon: 'coins', key: 'intro.chip3' },
  { icon: 'wheat', key: 'intro.chip4' },
  { icon: 'pin', key: 'intro.chip5' },
  { icon: 'paw', key: 'intro.chip6' },
];
---
<section id="intro" class="scroll-mt-[76px]">
  <div class="wrapper section-y grid grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] gap-[clamp(48px,7vw,112px)] items-center">
    <div class="flex flex-col items-start">
      <Eyebrow label={t('intro.label')} />
      <h2 class="mt-[22px] heading-display text-ink">{t('intro.heading')}</h2>
      <p class="mt-[clamp(20px,2.2vw,28px)] lead text-ink-soft">{t('intro.body')}</p>

      <ul class="mt-[clamp(32px,3.6vw,44px)] w-full grid grid-cols-[repeat(auto-fill,minmax(min(100%,210px),1fr))] gap-x-7 border-b border-line">
        {chips.map((c) => (
          <li class="flex items-center gap-3 py-[15px] border-t border-line">
            <Icon name={c.icon} class="w-5 h-5 text-brand shrink-0" />
            <span class="text-[15px] font-medium text-ink">{t(c.key)}</span>
          </li>
        ))}
      </ul>

      <a href={mailto(t('contact.subject'))} class="mt-[clamp(32px,3.6vw,44px)] inline-flex items-center h-[52px] px-7 rounded-full bg-forest text-white font-semibold hover:bg-soil transition-colors">{t('intro.cta')}</a>
    </div>

    <figure class="relative w-full aspect-[4/5] max-h-[760px] rounded-2xl overflow-hidden bg-panel">
      <Image src={cactusImg} alt={t('intro.heading')} class="absolute inset-0 w-full h-full max-w-none object-cover object-[50%_70%]" widths={[640, 960]} sizes="(min-width: 1000px) 540px, 100vw" />
      <figcaption class="absolute inset-x-4 bottom-4 flex flex-col gap-1 px-[18px] py-4 rounded-xl bg-cream/92 backdrop-blur-[10px]">
        <span class="text-xs leading-4 font-bold tracking-[0.14em] uppercase text-forest">{t('intro.card.title')}</span>
        <span class="text-sm leading-[1.45] text-ink-soft">{t('intro.card.body')}</span>
      </figcaption>
    </figure>
  </div>
</section>
