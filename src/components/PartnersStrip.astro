---
import { Image } from 'astro:assets';
import { partners } from '@/data/partners';
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="bg-panel py-8 border-b border-line">
  <div class="max-w-7xl mx-auto px-5 md:px-12 flex flex-col items-center">
    <span class="text-ink-soft text-xs font-bold tracking-widest uppercase mb-6">{t('partners.label')}</span>
    <div class="flex flex-wrap justify-center gap-x-10 gap-y-4 opacity-60">
      {partners.map((pt) => (
        pt.logo
          ? <Image src={pt.logo} alt={pt.label[lang]} class="h-10 w-auto grayscale opacity-70" widths={[200]} />
          : <span class="font-bold text-ink-soft">{pt.label[lang]}</span>
      ))}
    </div>
  </div>
</section>
