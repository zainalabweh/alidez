---
import Icon from '@/components/Icon.astro';
import { useTranslations, prefix, type Lang } from '@/i18n/utils';
import { mailto } from '@/config';

interface Props { lang: Lang; esPath: string; enPath: string }
const { lang, esPath, enPath } = Astro.props;
const t = useTranslations(lang);
const p = prefix(lang);

// Built pages end in a slash (/about/) but the links don't, so compare without it.
const trimSlash = (path: string) => path.replace(/\/+$/, '') || '/';
const current = trimSlash(Astro.url.pathname);

const links = [
  { href: `${p}/` || '/', label: t('nav.home') },
  { href: `${p}/solution`, label: t('nav.solution') },
  { href: `${p}/impact`, label: t('nav.impact') },
  { href: `${p}/about`, label: t('nav.about') },
  { href: `${p}/#contact`, label: t('nav.contact') },
].map((l) => ({ ...l, active: current === trimSlash(l.href) }));

const langs = [
  { code: 'es', label: 'ES', href: esPath },
  { code: 'en', label: 'EN', href: enPath },
] as const;
---
<nav class="sticky top-0 z-50 w-full bg-cream/86 backdrop-blur-[14px] backdrop-saturate-130 border-b border-line">
  <div class="wrapper h-[76px] flex items-center justify-between gap-8">
    <a href={`${p}/` || '/'} class="font-bold text-[25px] leading-none tracking-[-0.035em] text-forest hover:text-brand transition-colors">Alidez</a>

    <!-- Desktop (980px and up) -->
    <div class="hidden min-[980px]:flex items-center gap-[clamp(20px,2.4vw,34px)] text-[15px] font-medium">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={l.active ? 'page' : undefined}
          class:list={[
            'transition-colors',
            l.active
              ? 'text-ink font-semibold underline decoration-leaf decoration-2 underline-offset-[10px]'
              : 'text-ink-soft hover:text-ink',
          ]}
        >{l.label}</a>
      ))}
    </div>

    <div class="hidden min-[980px]:flex items-center gap-5">
      <div class="flex items-center gap-2 text-[13px] font-semibold tracking-[0.06em]">
        {langs.map((l, i) => (
          <>
            {i > 0 && <span class="w-px h-3 bg-line" aria-hidden="true"></span>}
            <a
              href={l.href}
              aria-current={lang === l.code ? 'true' : undefined}
              class:list={[lang === l.code ? 'text-forest' : 'text-ink-soft hover:text-ink transition-colors']}
            >{l.label}</a>
          </>
        ))}
      </div>
      <a href={mailto(t('contact.subject'))} class="inline-flex items-center h-[42px] px-5 rounded-full bg-forest text-white text-[15px] font-semibold hover:bg-soil transition-colors">{t('nav.cta')}</a>
    </div>

    <!-- Mobile and tablet -->
    <button id="menu-btn" type="button" class="min-[980px]:hidden -mr-2.5 w-11 h-11 flex items-center justify-center text-forest" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
      <span data-menu-icon="open"><Icon name="menu" class="w-6 h-6" /></span>
      <span data-menu-icon="close" class="hidden"><Icon name="x" class="w-6 h-6" /></span>
    </button>
  </div>

  <div id="mobile-menu" class="hidden min-[980px]:hidden absolute top-full inset-x-0 bg-cream border-b border-line shadow-[0_24px_40px_-24px_rgba(20,25,12,0.35)]">
    <div class="wrapper pt-2 pb-7">
      <div class="flex flex-col">
        {links.map((l) => (
          <a
            href={l.href}
            aria-current={l.active ? 'page' : undefined}
            class="flex items-center justify-between py-4 border-b border-line font-serif font-medium text-[26px] tracking-[-0.01em] text-ink hover:text-brand transition-colors"
          >
            {l.label}
            {l.active && <span class="w-2 h-2 rounded-full bg-leaf" aria-hidden="true"></span>}
          </a>
        ))}
      </div>
      <div class="flex items-center justify-between gap-4 mt-6">
        <div class="flex items-center gap-2 text-sm font-semibold tracking-[0.06em]">
          {langs.map((l, i) => (
            <>
              {i > 0 && <span class="w-px h-3 bg-line" aria-hidden="true"></span>}
              <a
                href={l.href}
                aria-current={lang === l.code ? 'true' : undefined}
                class:list={[lang === l.code ? 'text-forest' : 'text-ink-soft hover:text-brand transition-colors']}
              >{l.label}</a>
            </>
          ))}
        </div>
        <a href={mailto(t('contact.subject'))} class="inline-flex items-center h-12 px-6 rounded-full bg-forest text-white text-base font-semibold hover:bg-soil transition-colors">{t('nav.cta')}</a>
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');

  function setOpen(open: boolean) {
    menu?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.querySelector('[data-menu-icon="open"]')?.classList.toggle('hidden', open);
    btn?.querySelector('[data-menu-icon="close"]')?.classList.toggle('hidden', !open);
  }

  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  // Close after picking a link (matters for the same-page #contact link)
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
