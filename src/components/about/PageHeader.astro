---
interface Props { label: string; heading: string; sub?: string }
const { label, heading, sub } = Astro.props;
---
<header class="bg-forest w-full py-20 md:py-24 px-5 md:px-12 text-center flex flex-col items-center">
  <span class="text-amber text-xs font-bold uppercase tracking-widest mb-4">{label}</span>
  <h1 class="font-serif text-4xl md:text-6xl font-semibold text-white mb-4 max-w-4xl leading-tight">{heading}</h1>
  {sub && <p class="text-lg text-white/80 max-w-2xl">{sub}</p>}
</header>
