---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import plantationImg from '@/assets/photos/Nopal_Field_6.jpg';
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);

const points = [
  { icon: 'flag', key: 'about.mexico.p1' },
  { icon: 'globe', key: 'about.mexico.p2' },
  { icon: 'sprout', key: 'about.mexico.p3' },
  { icon: 'handshake', key: 'about.mexico.p4' },
];
---
<section class="bg-panel border-y border-line">
  <!-- wrap-reverse puts the text above the photo once they stack -->
  <div class="wrapper section-y flex flex-wrap-reverse items-center gap-[clamp(40px,7vw,112px)]">
    <figure class="flex-[1_1_440px] min-w-0 aspect-[4/3] rounded-2xl overflow-hidden bg-white">
      <Image
        src={plantationImg}
        alt={t('about.mexico.heading')}
        class="w-full h-full object-cover"
        widths={[640, 960]}
        sizes="(min-width: 1000px) 540px, 100vw"
      />
    </figure>

    <div class="flex-[1_1_400px] min-w-0">
      <Eyebrow label={t('about.mexico.label')} />
      <h2 class="mt-[22px] heading-section text-ink">{t('about.mexico.heading')}</h2>

      <ul class="mt-[clamp(28px,3.4vw,40px)] border-b border-line">
        {points.map((p) => (
          <li class="flex items-start gap-4 py-[18px] border-t border-line">
            <Icon name={p.icon} class="w-[22px] h-[22px] mt-px shrink-0 text-brand" />
            <span class="text-[17px] leading-[1.5] text-ink">{t(p.key)}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
