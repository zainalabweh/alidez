---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import { team } from '@/data/team';
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="py-20 md:py-28 px-5 md:px-12 bg-panel">
  <div class="max-w-4xl mx-auto flex flex-col items-center gap-12 md:gap-16">
    <div class="flex flex-col items-center gap-3 text-center">
      <span class="text-brand text-xs font-bold uppercase tracking-widest">{t('about.team.label')}</span>
      <h2 class="font-serif text-3xl md:text-4xl font-semibold text-ink">{t('about.team.heading')}</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 md:gap-16 w-full">
      {team.map((member) => (
        <div class="flex flex-col items-center sm:items-start text-center sm:text-left gap-4">
          <div class="w-28 h-28 rounded-full bg-white border border-line flex items-center justify-center overflow-hidden">
            { member.photo
              ? <Image src={member.photo} alt={member.name} class="w-full h-full object-cover" widths={[224]} />
              : <Icon name="user" class="w-10 h-10 text-line" />
            }
          </div>

          <div>
            <h3 class="font-bold text-xl text-ink">{member.name}</h3>
            <p class="text-xs uppercase tracking-widest text-brand font-bold mt-1">{member.role[lang]}</p>
          </div>

          <p class="text-base text-ink-soft">{member.summary[lang]}</p>

          <ul class="flex flex-col gap-2 text-left">
            {member.points[lang].map((pt) => (
              <li class="flex items-start gap-2.5 text-[15px] text-ink-soft">
                <span class="w-1.5 h-1.5 rounded-full bg-leaf mt-1.5 shrink-0"></span>
                <span>{pt}</span>
              </li>
            ))}
          </ul>

          {/* Showing the linkedin icon for now to show the design */}
          {/* TODO: update this */}
          {/* {member.linkedin && ( */}
          {!member.linkedin && (
            <a href={member.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn - ${member.name}`} class="text-ink-soft hover:text-brand transition-colors">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
