---
import Eyebrow from '@/components/Eyebrow.astro';
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---
<section>
  <div class="wrapper section-y grid grid-cols-[repeat(auto-fit,minmax(min(100%,400px),1fr))] gap-[clamp(36px,7vw,112px)] items-start">
    <div>
      <Eyebrow label={t('about.story.label')} />
      <h2 class="mt-[22px] font-serif font-medium text-[clamp(34px,4.2vw,56px)] leading-[1.05] tracking-[-0.022em] text-ink text-balance">
        {t('about.story.heading')}
      </h2>
    </div>

    <div class="pt-[clamp(0px,1.2vw,10px)]">
      <blockquote class="pl-[clamp(20px,2.4vw,32px)] border-l-3 border-leaf">
        <p class="font-serif italic font-medium text-[clamp(24px,2.5vw,34px)] leading-[1.28] tracking-[-0.01em] text-forest text-pretty">{t('about.story.quote')}</p>
      </blockquote>
      <p class="mt-[clamp(28px,3vw,40px)] text-[clamp(17px,1.45vw,19px)] leading-[1.65] text-ink-soft text-pretty">{t('about.story.body')}</p>
    </div>
  </div>
</section>
