---
import Icon from '@/components/Icon.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import { useTranslations, prefix, type Lang } from '@/i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = prefix(lang);

const items = [
  { icon: 'droplet', n: 1 },
  { icon: 'leaf', n: 2 },
  { icon: 'mountain', n: 3 },
  { icon: 'trees', n: 4 },
];
---
<section class="border-b border-line">
  <div class="wrapper py-[clamp(72px,9vw,120px)]">
    <div class="flex flex-wrap justify-between items-end gap-x-12 gap-y-5">
      <div>
        <Eyebrow label={t('impact.label')} />
        <h2 class="mt-[22px] heading-section text-ink">{t('impact.heading')}</h2>
      </div>
      <a href={`${p}/impact`} class="inline-flex items-center gap-2.5 py-2 text-base font-semibold text-forest underline decoration-line decoration-[1.5px] underline-offset-8 hover:decoration-brand transition-colors">
        {t('impact.link')}<Icon name="arrowRight" class="w-[18px] h-[18px]" />
      </a>
    </div>

    <div class="mt-[clamp(40px,5vw,64px)] grid grid-cols-[repeat(auto-fit,minmax(min(100%,230px),1fr))] gap-y-2 gap-x-[clamp(24px,3vw,40px)]">
      {items.map((it) => (
        <div class="flex flex-col pt-7 border-t border-line">
          <Icon name={it.icon} class="w-[26px] h-[26px] text-brand" />
          <h3 class="mt-[22px] heading-item text-ink">{t(`impact.${it.n}.t`)}</h3>
          <p class="mt-2 text-[15.5px] leading-[1.55] text-ink-soft">{t(`impact.${it.n}.d`)}</p>
        </div>
      ))}
    </div>
  </div>
</section>
