---
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from '@/i18n/utils';

// Portrait cards with a gradient overlay and the species name bottom-left.
// Alternative treatment to SpeciesCards.astro - pick one before launch.
import beefImg from '@/assets/ai/beef-cattle-2.png';
import dairyImg from '@/assets/ai/dairy-cattle.jpg';
import sheepImg from '@/assets/ai/sheep.jpg';
import goatsImg from '@/assets/ai/goats.jpg';

interface Props { lang: Lang; showHeading?: boolean; class?: string }
const { lang, showHeading = true, class: cls } = Astro.props;
const t = useTranslations(lang);

const species = [
  { n: 1, img: beefImg },
  { n: 2, img: dairyImg },
  { n: 3, img: sheepImg },
  { n: 4, img: goatsImg },
];
---
<section class={cls}>
  <div class="wrapper section-y">
    {showHeading && <h2 class="heading-section text-ink">{t('species.heading')}</h2>}

    <div class:list={[
      'grid grid-cols-[repeat(auto-fit,minmax(min(100%,150px),1fr))] gap-[clamp(12px,2vw,24px)]',
      showHeading && 'mt-[clamp(36px,4.4vw,56px)]',
    ]}>
      {species.map((s) => (
        <div class="relative aspect-[4/5] rounded-[14px] overflow-hidden bg-panel">
          <Image
            src={s.img}
            alt={t(`species.${s.n}.t`)}
            class="absolute inset-0 w-full h-full max-w-none object-cover transition-transform duration-[800ms] ease-[cubic-bezier(.2,.7,.2,1)] hover:scale-[1.04] motion-reduce:transition-none motion-reduce:hover:scale-100"
            widths={[400, 600]}
            sizes="(min-width: 1100px) 280px, 50vw"
          />
          <div class="absolute inset-0 bg-[linear-gradient(0deg,rgba(20,25,12,0.88)_0%,rgba(20,25,12,0.3)_45%,rgba(20,25,12,0)_70%)] pointer-events-none" aria-hidden="true"></div>
          <div class="absolute inset-x-0 bottom-0 p-[clamp(14px,1.8vw,22px)] pointer-events-none">
            <h3 class="text-[19px] leading-[1.25] font-semibold text-white">{t(`species.${s.n}.t`)}</h3>
            <p class="mt-1.5 text-[14.5px] leading-[1.45] text-white/86">{t(`species.${s.n}.d`)}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
