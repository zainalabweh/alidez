---
// Small uppercase label with a short rule in front, shown above section headings.
// Use tone="dark" on forest-green backgrounds.
interface Props { label: string; tone?: 'light' | 'dark'; class?: string }
const { label, tone = 'light', class: cls } = Astro.props;
---
<div class:list={['flex items-center gap-3', cls]}>
  <span class:list={['w-7 h-0.5 flex-none', tone === 'dark' ? 'bg-leaf' : 'bg-brand']} aria-hidden="true"></span>
  <span class:list={['eyebrow', tone === 'dark' ? 'text-amber' : 'text-forest']}>{label}</span>
</div>
