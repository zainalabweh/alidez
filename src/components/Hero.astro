---
import { Image } from 'astro:assets';
import heroImg from '@/assets/photos/Nopal_Field_12.jpg';
import { useTranslations, type Lang } from '@/i18n/utils';
import { mailto } from '@/config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="relative w-full min-h-[90svh] flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 z-0">
    <Image
      src={heroImg}
      alt=""
      class="w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      widths={[768, 1280, 1920]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-soil/70"></div>
  </div>

  <div class="relative z-10 text-center px-5 md:px-12 max-w-4xl mx-auto flex flex-col items-center mt-6 md:mt-12 pb-12">
    <h1 class="font-serif text-[2.1rem] leading-[1.15] md:text-6xl md:leading-tight text-white font-semibold mb-6">
      {t('hero.headline.pre')}<span class="text-leaf italic">{t('hero.headline.accent')}</span>
    </h1>
    <p class="text-base md:text-lg text-white/80 max-w-2xl mb-8 md:mb-10 mx-auto leading-relaxed">
      {t('hero.subhead')}
    </p>

    <div class="flex flex-col sm:flex-row gap-4 mb-8 md:mb-12">
      <a href={mailto(t('contact.subject'))} class="bg-leaf text-soil px-8 py-4 rounded-xl font-bold hover:brightness-95 transition text-lg shadow-lg text-center">{t('hero.cta.contact')}</a>
      <a href="#intro" class="border-2 border-white text-white px-8 py-4 rounded-xl font-bold hover:bg-white/10 transition text-lg text-center">{t('hero.cta.learn')}</a>
    </div>

    <div class="bg-cream/90 backdrop-blur-md p-4 md:p-6 rounded-xl shadow-lg grid grid-cols-3 md:flex gap-2 md:gap-8 items-center border border-line w-full max-w-md md:max-w-none md:w-auto">
      {[1, 2, 3].map((i, idx) => (
        <>
          {idx > 0 && <div class="w-px h-8 bg-line hidden md:block"></div>}
          <div class="flex flex-col items-center text-center">
            <span class="text-forest font-bold text-sm md:text-lg">{t(`hero.stat${i}.value`)}</span>
            <span class="text-ink-soft text-[9px] md:text-[10px] tracking-widest uppercase leading-tight">{t(`hero.stat${i}.label`)}</span>
          </div>
        </>
      ))}
    </div>
  </div>
</section>
