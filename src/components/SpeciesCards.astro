---
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from '@/i18n/utils';

// Photo with the species name and description underneath.
// SpeciesCardsOverlay.astro is the alternative with the text over the photo.
import beefImg from '@/assets/ai/beef-cattle-2.png';
import dairyImg from '@/assets/ai/dairy-cattle.jpg';
import sheepImg from '@/assets/ai/sheep.jpg';
import goatsImg from '@/assets/ai/goats.jpg';

interface Props { lang: Lang; class?: string }
const { lang, class: cls } = Astro.props;
const t = useTranslations(lang);

const species = [
  { n: 1, img: beefImg },
  { n: 2, img: dairyImg },
  { n: 3, img: sheepImg },
  { n: 4, img: goatsImg },
];
---
<section class={cls}>
  <div class="wrapper section-y">
    <h2 class="heading-section text-ink">{t('species.heading')}</h2>

    <div class="mt-[clamp(36px,4.4vw,56px)] grid grid-cols-[repeat(auto-fit,minmax(min(100%,150px),1fr))] gap-y-[clamp(28px,3vw,40px)] gap-x-[clamp(16px,2.4vw,32px)]">
      {species.map((s) => (
        <div class="flex flex-col">
          <div class="aspect-[4/3] rounded-[14px] overflow-hidden bg-panel">
            <Image
              src={s.img}
              alt={t(`species.${s.n}.t`)}
              class="w-full h-full object-cover transition-transform duration-[800ms] ease-[cubic-bezier(.2,.7,.2,1)] hover:scale-[1.04] motion-reduce:transition-none motion-reduce:hover:scale-100"
              widths={[400, 600]}
              sizes="(min-width: 1100px) 280px, 50vw"
            />
          </div>
          <h3 class="mt-[18px] heading-item text-ink">{t(`species.${s.n}.t`)}</h3>
          <p class="mt-1.5 text-[15.5px] leading-[1.5] text-ink-soft">{t(`species.${s.n}.d`)}</p>
        </div>
      ))}
    </div>
  </div>
</section>
