---
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const rows = [1, 2, 3, 4, 5, 6].map((r) => ({
  m: t(`table.r${r}.m`),
  c: t(`table.r${r}.c`),
  a: t(`table.r${r}.a`),
}));
---

<section class="py-24 md:py-32 px-5 md:px-12 bg-panel">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-16">
      <span class="text-brand text-xs font-bold tracking-widest uppercase mb-4 block">{t('table.label')}</span>
      <h2 class="font-serif text-3xl md:text-4xl leading-tight text-ink">{t('table.heading')}</h2>
    </div>

    <div class="overflow-x-auto shadow-xl rounded-xl">
      <!-- Mobile: metric cards v1 -->
      <div class="md:hidden space-y-3">
        {rows.map((row) => (
          <div class="bg-white rounded-xl border border-line shadow-sm overflow-hidden">
            <div class="px-4 py-3 font-semibold text-ink border-b border-line">{row.m}</div>
            <div class="grid grid-cols-2">
              <div class="px-4 py-3">
                <div class="text-[10px] uppercase tracking-widest text-ink-soft mb-1">{t('table.col.corn')}</div>
                <div class="text-sm text-ink-soft">{row.c}</div>
              </div>
              <div class="px-4 py-3 bg-brand/10">
                <div class="text-[10px] uppercase tracking-widest text-forest mb-1">{t('table.col.alidez')}</div>
                <div class="text-sm text-forest font-semibold">{row.a}</div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Mobile: metric cards v2 -->
      <!-- <div class="md:hidden">
        <div class="grid grid-cols-2 px-4 mb-2">
          <span class="text-[10px] uppercase tracking-widest text-ink-soft">{t('table.col.corn')}</span>
          <span class="text-[10px] uppercase tracking-widest text-forest font-bold pl-4">{t('table.col.alidez')}</span>
        </div>
      
        <div class="space-y-2.5">
          {rows.map((row) => (
            <div class="bg-white rounded-xl border border-line shadow-sm overflow-hidden">
              {/* no rounding, no shadow, no margin on anything inside this div */}
              <div class="px-4 pt-3 pb-2 font-semibold text-ink text-[15px]">{row.m}</div>
              <div class="grid grid-cols-2 border-t border-line">
                <div class="px-4 py-3 text-sm text-ink-soft">{row.c}</div>
                <div class="px-4 py-3 text-sm text-forest font-semibold bg-brand/10">{row.a}</div>
              </div>
            </div>
          ))}
        </div>
      </div> -->

      <!-- Desktop: real table -->
      <div class="hidden md:block overflow-x-auto shadow-xl rounded-xl bg-white">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-line">
              <th class="p-5 md:p-6 font-semibold text-ink">{t('table.col.metric')}</th>
              <th class="p-5 md:p-6 font-semibold text-ink-soft">{t('table.col.corn')}</th>
              <th class="p-5 md:p-6 font-semibold text-forest bg-brand/10">{t('table.col.alidez')}</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row, index) => (
              <tr class:list={[index < rows.length - 1 && 'border-b border-line']}>
                <td class="p-5 md:p-6 text-ink font-semibold">{row.m}</td>
                <td class="p-5 md:p-6 text-ink-soft">{row.c}</td>
                <td class="p-5 md:p-6 text-forest bg-brand/10 font-medium">{row.a}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
